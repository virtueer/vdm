{
    "manifest_version": 3,
    "name": "VDM Extension",
    "version": "1.0",
    "description": "Automatically detects video links (m3u8, mp4, etc.) on web pages.",
    "permissions": [
        "webRequest",
        "storage",
        "activeTab",
        "downloads",
        "tabs"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content.js"
            ],
            "all_frames": true
        }
    ],
    "action": {
        "default_popup": "popup-dist/index.html",
        "default_title": "Video Links"
    }
}