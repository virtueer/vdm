{
    "manifest_version": 3,
    "name": "Video Download Manager",
    "version": "1.1",
    "description": "Automatically intercepts video downloads and sends them to Video Download Manager desktop app.",
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "permissions": [
        "webRequest",
        "storage",
        "activeTab",
        "downloads",
        "downloads.open",
        "tabs"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content.js"
            ],
            "all_frames": true
        }
    ],
    "action": {
        "default_popup": "popup-dist/index.html",
        "default_title": "Video Download Manager",
        "default_icon": {
            "16": "icons/icon16.png",
            "32": "icons/icon32.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    }
}
